export component TestCase {
    out property<bool> sw_prefix: "Apple".starts-with("App");
    out property<bool> sw_not: "Apple".starts-with("ple");
    out property<bool> sw_empty: "Apple".starts-with("");
    out property<bool> sw_unicode: "café".starts-with("ca");
    out property<bool> ct_mid: "Apple".contains("ppl");
    out property<bool> ct_not: "Apple".contains("xyz");
    out property<bool> ct_empty: "Apple".contains("");
    out property<bool> ct_unicode: "café".contains("fé");
    // case-insensitive typeahead composition (the motivating use)
    out property<bool> ci_typeahead: "Apple".to-lowercase().starts-with("app".to-lowercase());
}

